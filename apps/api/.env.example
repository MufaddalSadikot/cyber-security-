# ---- Database ----
# Default (dev): local SQLite file. Zero setup, works everywhere.
DATABASE_URL=sqlite:///./pvcc.db
# Production (PostgreSQL) example — install psycopg2-binary and switch:
# DATABASE_URL=postgresql+psycopg2://pvcc:pvcc@localhost:5432/pvcc

# ---- Auth ----
# Must be >= 32 bytes for HS256.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS ----
# Comma-separated origins, or * for the demo.
CORS_ORIGINS=*

# ---- AI provider abstraction ----
# "mock" = deterministic demo provider. "real" = plug in your LLM/VLM.
AI_PROVIDER=mock

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120
