{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@pvcc/shared": ["../../packages/shared/src/index.ts"],
      "@pvcc/privacy-engine": ["../../packages/privacy-engine/src/index.ts"],
      "@pvcc/context-compiler": ["../../packages/context-compiler/src/index.ts"],
      "@pvcc/action-policy": ["../../packages/action-policy/src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "../../packages/*/src"]
}
